---
const currentYear = new Date().getFullYear();
const githubUrl = 'https://github.com/tobyhede/turboshovel';
---

<footer class="py-12 px-4 border-t border-cyber-purple/20">
  <div class="container mx-auto max-w-4xl">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="text-center md:text-left">
        <p class="text-gray-500 text-sm">
          MIT License &copy; {currentYear}
        </p>
      </div>

      <div class="flex gap-6">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-cyber-cyan transition-colors"
        >
          GitHub
        </a>
        <a
          href={`${githubUrl}/blob/main/SETUP.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-cyber-magenta transition-colors"
        >
          Setup Guide
        </a>
        <a
          href={`${githubUrl}/blob/main/CONVENTIONS.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-cyber-purple transition-colors"
        >
          Conventions
        </a>
      </div>
    </div>
  </div>
</footer>
