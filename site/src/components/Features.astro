---
const features = [
  {
    title: 'Context Injection',
    description: 'Auto-inject project rules from .claude/context/ markdown files exactly when needed',
    icon: '🧠',
    color: 'cyan',
  },
  {
    title: 'Quality Gates',
    description: 'Block agents when lint, test, or build fails. Configurable pass/fail actions',
    icon: '🛡️',
    color: 'magenta',
  },
  {
    title: 'TypeScript Gates',
    description: 'Custom gates in TypeScript for complex validation logic beyond shell commands',
    icon: '📝',
    color: 'purple',
  },
  {
    title: 'Session Tracking',
    description: 'State persists across hook invocations. Track edited files, active commands, and more',
    icon: '💾',
    color: 'cyan',
  },
];

const colorClasses = {
  cyan: 'border-cyber-cyan/30 hover:border-cyber-cyan hover:shadow-neon-cyan',
  magenta: 'border-cyber-magenta/30 hover:border-cyber-magenta hover:shadow-neon-magenta',
  purple: 'border-cyber-purple/30 hover:border-cyber-purple hover:shadow-neon-purple',
};
---

<section id="features" class="py-24 px-4">
  <div class="container mx-auto max-w-6xl">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">
      <span class="text-cyber-magenta neon-text-magenta">Features</span>
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      {features.map((feature) => (
        <div
          class={`p-6 rounded-xl bg-cyber-dark/50 border transition-all duration-300 ${colorClasses[feature.color]}`}
        >
          <div class="text-4xl mb-4">{feature.icon}</div>
          <h3 class="text-xl font-bold text-white mb-2">{feature.title}</h3>
          <p class="text-gray-400">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
