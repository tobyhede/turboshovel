# Base stage with common setup
FROM node:22-slim AS base

# Install Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code

# Verify Claude Code installed
RUN claude --version

# Create test workspace
WORKDIR /test

# Copy test entrypoint
COPY scripts/docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

# Local mode: needs tarballs and plugin source
FROM base AS local
COPY dist/*.tgz ./packages/
COPY plugin/ ./plugin/

# NPM mode: minimal, installs from registry
FROM base AS npm
# No local artifacts needed - installs from npm registry at runtime
